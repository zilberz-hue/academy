{
  "name": "academy",
  "version": "1.0.0",
  "description": "קורסי טיזון — רפואה סינית ונטורופתיה · ד״ר צחי זילבר",
  "private": true,
  "scripts": {
    "index": "python3 scripts/build-index.py",
    "standalone": "python3 scripts/build-standalone.py --fonts",
    "pdf": "npm run standalone && node scripts/build-pdf.js",
    "build": "npm run index && npm run pdf && npm run check",
    "check": "node scripts/check.js"
  },
  "devDependencies": {
    "@fontsource/assistant": "^5.0.0",
    "@fontsource/frank-ruhl-libre": "^5.0.0",
    "playwright": "^1.40.0"
  }
}
